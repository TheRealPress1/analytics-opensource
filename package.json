{
	"name": "analytics-opensource",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22 <27"
	},
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "vitest run",
		"lint": "biome check .",
		"dev:api": "tsx watch apps/api/src/index.ts",
