	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.15.0",
		"tsx": "^4.21.0",
		"turbo": "^2.8.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
