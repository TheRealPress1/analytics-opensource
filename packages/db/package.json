		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@subkit/core": "workspace:*",
		"@google-cloud/cloud-sql-connector": "^1.8.5",
		"drizzle-orm": "0.45.4",
		"pg": "^8.16.3"
	}
}
